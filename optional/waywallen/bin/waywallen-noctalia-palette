#!/usr/bin/env bash
# Bridge: Waywallen active wallpaper → Noctalia wallpaper-derived palette.
# Does NOT enable Noctalia wallpaper drawing (keeps [wallpaper] enabled = false).
set -euo pipefail

FORCE=0
for arg in "$@"; do
  case "$arg" in
    --force|-f) FORCE=1 ;;
    -h|--help)
      printf '%s\n' "Usage: waywallen-noctalia-palette [--force]"
      printf '%s\n' "  Also applies GTK/Qt/KDE via waywallen-gtk-qt-palette (same image)."
      exit 0
      ;;
  esac
done

MAIN_CONNECTOR="${WAYWALLEN_MAIN_CONNECTOR:-DP-2}"
WW_CONFIG="${WAYWALLEN_CONFIG:-$HOME/.config/waywallen/config.toml}"
WW_DB="${WAYWALLEN_DB:-$HOME/.local/share/waywallen/waywallen-v2.db}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/noctalia"
CACHE_JPG="$CACHE_DIR/waywallen-main.jpg"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE_DIR/waywallen-noctalia-palette.log"
STATE_FILE="$STATE_DIR/waywallen-noctalia-palette.state"
THEME_MARKER="$STATE_DIR/waywallen-noctalia-palette.theme-ok"
WALLPAPER_SCHEME="${NOCTALIA_WALLPAPER_SCHEME:-m3-content}"

mkdir -p "$CACHE_DIR" "$STATE_DIR"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" "$*" | tee -a "$LOG" >/dev/null
  if [[ -f "$LOG" ]] && [[ $(wc -c <"$LOG") -gt 200000 ]]; then
    tail -n 200 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
}

die() { log "ERROR: $*"; exit 1; }

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }

need_cmd sqlite3
need_cmd noctalia

# Noctalia IPC must be up before wallpaper-set / color-scheme-set.
# Otherwise a boot race can encode a transient preview, die mid-apply, and
# leave cache desynced while state still matches an older wallpaper hash.
wait_noctalia() {
  local i
  for i in $(seq 1 40); do
    if noctalia msg color-scheme-get >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

if ! wait_noctalia; then
  die "noctalia is not running (IPC timeout)"
fi


[[ -f "$WW_CONFIG" ]] || die "Waywallen config not found: $WW_CONFIG"
[[ -f "$WW_DB" ]] || die "Waywallen DB not found: $WW_DB"

# Extract workshop id from a process cmdline (or empty).
_extract_workshop_id() {
  local line="$1" id=""
  if [[ "$line" =~ --workshop_id(=|[[:space:]]+)([0-9]+) ]]; then
    id="${BASH_REMATCH[2]}"
  elif [[ "$line" =~ /431960/([0-9]+)(/|[[:space:]]|$) ]]; then
    id="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ [[:space:]]([0-9]{6,})([[:space:]]|$) ]]; then
    # trailing bare workshop id (weweb often ends with it)
    id="${BASH_REMATCH[1]}"
  fi
  printf '%s' "$id"
}

# 1) Running renderers — prefer wescene over weweb; one main scene.
resolve_from_processes() {
  local line kind id
  local -a scenes=() webs=()
  # Main renderer only (skip chromium helper --type=…)
  while IFS= read -r line; do
    [[ "$line" == *'--type='* ]] && continue
    id="$(_extract_workshop_id "$line")"
    [[ -n "$id" ]] || continue
    if [[ "$line" == *wescene-renderer* ]]; then
      scenes+=("$id")
    elif [[ "$line" == *weweb-renderer* ]]; then
      webs+=("$id")
    fi
  done < <(pgrep -af 'waywallen-wescene-renderer|waywallen-weweb-renderer' 2>/dev/null || true)

  if ((${#scenes[@]} > 0)); then
    # Prefer scene matching global last_wallpaper's external_id when multiple.
    local prefer=""
    prefer="$(awk '
      BEGIN{in_g=0}
      $0=="[global]"{in_g=1;next}
      $0 ~ /^\[/{in_g=0}
      in_g && $0 ~ /^last_wallpaper[[:space:]]*=/{
        gsub(/"/,"",$3); print $3; exit
      }
    ' "$WW_CONFIG" 2>/dev/null || true)"
    if [[ -n "$prefer" ]]; then
      local ext
      ext=$(sqlite3 "$WW_DB" "SELECT COALESCE(external_id,'') FROM item WHERE id=CAST('$prefer' AS INTEGER) LIMIT 1;" 2>/dev/null || true)
      if [[ -n "$ext" ]]; then
        for id in "${scenes[@]}"; do
          if [[ "$id" == "$ext" ]]; then
            printf 'workshop\t%s' "$id"
            return 0
          fi
        done
      fi
    fi
    printf 'workshop\t%s' "${scenes[0]}"
    return 0
  fi
  if ((${#webs[@]} > 0)); then
    printf 'workshop\t%s' "${webs[0]}"
    return 0
  fi
  return 1
}

# Parse last_wallpaper from a named display header match / global / layer-*
_toml_last_wallpaper_in_sections() {
  # Args: mode = global | layer | connector
  local mode="$1" connector="${2:-}"
  awk -v mode="$mode" -v c="$connector" '
    BEGIN { insec=0; best="" }
    mode=="global" {
      if ($0 == "[global]") { insec=1; next }
      if ($0 ~ /^\[/) { insec=0 }
      if (insec && $0 ~ /^last_wallpaper[[:space:]]*=/) {
        gsub(/"/, "", $3); print $3; exit
      }
      next
    }
    mode=="layer" {
      if ($0 ~ /^\[display\.layer-/) { insec=1; next }
      if ($0 ~ /^\[/) { insec=0 }
      if (insec && $0 ~ /^last_wallpaper[[:space:]]*=/) {
        gsub(/"/, "", $3); best=$3
        insec=0
      }
      next
    }
    mode=="connector" {
      if ($0 ~ /^\[display\./) {
        insec = (index($0, ":" c) > 0)
        next
      }
      if (insec && $0 ~ /^last_wallpaper[[:space:]]*=/) {
        gsub(/"/, "", $3); print $3; exit
      }
    }
    END {
      if (mode=="layer" && best != "") print best
    }
  ' "$WW_CONFIG"
}

# Collect layer-* last_wallpaper values (file order); print all, last is "newest".
_toml_all_layer_wallpapers() {
  awk '
    BEGIN { insec=0 }
    $0 ~ /^\[display\.layer-/ { insec=1; next }
    $0 ~ /^\[/ { insec=0 }
    insec && $0 ~ /^last_wallpaper[[:space:]]*=/ {
      gsub(/"/, "", $3); print $3; insec=0
    }
  ' "$WW_CONFIG"
}

# Map item id → prefer scene type when choosing among layer candidates.
_item_is_sceneish() {
  local iid="$1" typ path
  typ=$(sqlite3 "$WW_DB" "SELECT COALESCE(type,'') FROM item WHERE id=CAST('$iid' AS INTEGER) LIMIT 1;" 2>/dev/null || true)
  path=$(sqlite3 "$WW_DB" "SELECT COALESCE(path,'') FROM item WHERE id=CAST('$iid' AS INTEGER) LIMIT 1;" 2>/dev/null || true)
  [[ "$typ" == *scene* || "$path" == *scene.pkg* || "$path" == */scene* ]]
}

resolve_from_config() {
  local id layers=() lid
  id="$(_toml_last_wallpaper_in_sections global)"
  if [[ -n "$id" ]]; then
    printf 'item\t%s' "$id"
    return 0
  fi

  mapfile -t layers < <(_toml_all_layer_wallpapers)
  if ((${#layers[@]} > 0)); then
    # Prefer a scene-ish layer id (scan newest→oldest), else newest.
    local i
    for ((i=${#layers[@]}-1; i>=0; i--)); do
      lid="${layers[$i]}"
      if _item_is_sceneish "$lid"; then
        printf 'item\t%s' "$lid"
        return 0
      fi
    done
    printf 'item\t%s' "${layers[-1]}"
    return 0
  fi

  id="$(_toml_last_wallpaper_in_sections connector "$MAIN_CONNECTOR")"
  if [[ -n "$id" ]]; then
    printf 'item\t%s' "$id"
    return 0
  fi
  return 1
}

KIND=""
REF=""
SOURCE=""

if resolved="$(resolve_from_processes)"; then
  KIND="${resolved%%$'\t'*}"
  REF="${resolved#*$'\t'}"
  SOURCE="process"
elif resolved="$(resolve_from_config)"; then
  KIND="${resolved%%$'\t'*}"
  REF="${resolved#*$'\t'}"
  SOURCE="config"
else
  die "could not resolve active wallpaper (no renderer, no config last_wallpaper)"
fi

# Resolve DB row from workshop external_id or item id
if [[ "$KIND" == "workshop" ]]; then
  ROW=$(sqlite3 -separator $'\t' "$WW_DB" "
SELECT i.id,
       COALESCE(i.preview_path, ''),
       COALESCE(i.path, ''),
       COALESCE(i.external_id, ''),
       COALESCE(l.path, '')
FROM item i
LEFT JOIN library l ON l.id = i.library_id
WHERE i.external_id = '$REF'
LIMIT 1;
") || die "sqlite query failed for workshop $REF"
  [[ -n "$ROW" ]] || die "workshop external_id $REF not found in DB"
else
  ROW=$(sqlite3 -separator $'\t' "$WW_DB" "
SELECT i.id,
       COALESCE(i.preview_path, ''),
       COALESCE(i.path, ''),
       COALESCE(i.external_id, ''),
       COALESCE(l.path, '')
FROM item i
LEFT JOIN library l ON l.id = i.library_id
WHERE i.id = CAST('$REF' AS INTEGER)
LIMIT 1;
") || die "sqlite query failed for item $REF"
  [[ -n "$ROW" ]] || die "item id $REF not found in DB"
fi

IFS=$'\t' read -r ITEM_ID PREVIEW_REL ITEM_REL EXTERNAL_ID LIB_ROOT <<<"$ROW"

# State key: prefer workshop id when known (stable across layer renames)
if [[ -n "$EXTERNAL_ID" ]]; then
  STATE_KEY="w:$EXTERNAL_ID"
else
  STATE_KEY="i:$ITEM_ID"
fi

cache_ok=0
if [[ -f "$CACHE_JPG" ]] && [[ -s "$CACHE_JPG" ]]; then
  cache_ok=1
fi

# Defer exit until SRC fingerprint is known (hash change re-applies without --force).
STATE_PREV=""
if [[ "$FORCE" -eq 0 && -f "$STATE_FILE" ]]; then
  prev="$(cat "$STATE_FILE" 2>/dev/null || true)"
  prev_key="${prev%% *}"
  key_ok=0
  if [[ "$prev_key" == "$STATE_KEY" || "$prev" == "$ITEM_ID" ]]; then
    key_ok=1
  elif [[ -n "$EXTERNAL_ID" && "$prev_key" == "w:$EXTERNAL_ID" ]]; then
    key_ok=1
  fi
  if [[ "$key_ok" -eq 1 && "$cache_ok" -eq 1 ]]; then
    STATE_PREV="$prev"
  elif [[ "$key_ok" -eq 1 && "$cache_ok" -eq 0 ]]; then
    log "state matches $STATE_KEY but cache missing/empty — re-apply"
  fi
fi

abs_join() {
  local root="$1" rel="$2"
  if [[ -z "$rel" ]]; then
    printf ''
    return
  fi
  if [[ "$rel" = /* ]]; then
    printf '%s' "$rel"
  elif [[ -n "$root" ]]; then
    printf '%s/%s' "${root%/}" "$rel"
  else
    printf '%s' "$rel"
  fi
}

CANDIDATES=()
PREVIEW_ABS="$(abs_join "$LIB_ROOT" "$PREVIEW_REL")"
[[ -n "$PREVIEW_ABS" ]] && CANDIDATES+=("$PREVIEW_ABS")

if [[ -n "$EXTERNAL_ID" ]]; then
  WS_BASE=""
  if [[ -n "$LIB_ROOT" ]]; then
    WS_BASE="$LIB_ROOT/steamapps/workshop/content/431960/$EXTERNAL_ID"
  else
    WS_BASE="$HOME/.local/share/Steam/steamapps/workshop/content/431960/$EXTERNAL_ID"
  fi
  # Prefer still formats before gif in the seed list; rank_candidates re-orders firmly.
  for name in preview.jpg preview.png preview.webp preview.jpeg Preview.jpg Preview.png preview.gif Preview.gif; do
    CANDIDATES+=("$WS_BASE/$name")
  done
fi

ITEM_ABS="$(abs_join "$LIB_ROOT" "$ITEM_REL")"
case "${ITEM_ABS,,}" in
  *.jpg|*.jpeg|*.png|*.webp|*.gif) CANDIDATES+=("$ITEM_ABS") ;;
esac

# Rank: non-gif first, then larger file size. Deduplicate.
rank_candidates() {
  local -a unique=()
  local c u seen
  for c in "${CANDIDATES[@]}"; do
    [[ -n "$c" && -f "$c" ]] || continue
    seen=0
    for u in "${unique[@]+"${unique[@]}"}"; do
      if [[ "$u" == "$c" ]]; then seen=1; break; fi
    done
    [[ "$seen" -eq 1 ]] && continue
    unique+=("$c")
  done
  ((${#unique[@]} > 0)) || return 1
  for c in "${unique[@]}"; do
    local ext="${c##*.}"
    ext="${ext,,}"
    local is_gif=0
    [[ "$ext" == "gif" ]] && is_gif=1
    local sz=0
    sz=$(stat -c '%s' "$c" 2>/dev/null || echo 0)
    printf '%d %d %s\n' "$is_gif" "$sz" "$c"
  done | sort -k1,1n -k2,2nr | awk '{ $1=""; $2=""; sub(/^  /,""); print }'
}

SRC=""
while IFS= read -r c; do
  [[ -n "$c" ]] || continue
  SRC="$c"
  break
done < <(rank_candidates || true)

[[ -n "$SRC" ]] || die "no preview image found for item $ITEM_ID (external=$EXTERNAL_ID)"

# Content fingerprint of chosen source (re-apply when preview file changes but id does not).
SRC_HASH=""
if command -v sha256sum >/dev/null 2>&1; then
  SRC_HASH="$(sha256sum "$SRC" | awk '{print $1}')"
elif command -v sha256 >/dev/null 2>&1; then
  SRC_HASH="$(sha256 -q "$SRC" 2>/dev/null || true)"
fi
CACHE_HASH=""
if [[ "$cache_ok" -eq 1 ]]; then
  if command -v sha256sum >/dev/null 2>&1; then
    CACHE_HASH="$(sha256sum "$CACHE_JPG" | awk '{print $1}')"
  elif command -v sha256 >/dev/null 2>&1; then
    CACHE_HASH="$(sha256 -q "$CACHE_JPG" 2>/dev/null || true)"
  fi
fi

STATE_PAYLOAD="$STATE_KEY"
[[ -n "$SRC_HASH" ]] && STATE_PAYLOAD="$STATE_PAYLOAD sha256:$SRC_HASH"
[[ -n "$CACHE_HASH" ]] && STATE_PAYLOAD="$STATE_PAYLOAD cache:$CACHE_HASH"
STATE_PAYLOAD="$STATE_PAYLOAD scheme:$WALLPAPER_SCHEME"

# Short-circuit only when source + cache + scheme all match (prevents boot-race desync).
if [[ "$FORCE" -eq 0 && -n "${STATE_PREV:-}" && "$cache_ok" -eq 1 ]]; then
  prev_src=""
  prev_cache=""
  prev_scheme=""
  for tok in $STATE_PREV; do
    case "$tok" in
      sha256:*) prev_src="${tok#sha256:}" ;;
      cache:*) prev_cache="${tok#cache:}" ;;
      scheme:*) prev_scheme="${tok#scheme:}" ;;
    esac
  done
  # Legacy: "sha256:X" may be followed by nothing; strip accidental "cache:..." if glued
  prev_src="${prev_src%% *}"
  hash_ok=0
  cache_match=0
  scheme_match=0
  if [[ -n "$SRC_HASH" && -n "$prev_src" && "$prev_src" == "$SRC_HASH" ]]; then
    hash_ok=1
  elif [[ -z "$prev_src" ]]; then
    hash_ok=1
  fi
  if [[ -n "$CACHE_HASH" && -n "$prev_cache" && "$prev_cache" == "$CACHE_HASH" ]]; then
    cache_match=1
  elif [[ -z "$prev_cache" ]]; then
    # Legacy state without cache fingerprint: force re-encode once to heal desync
    cache_match=0
  fi
  if [[ -n "$prev_scheme" && "$prev_scheme" == "$WALLPAPER_SCHEME" ]]; then
    scheme_match=1
  elif [[ -z "$prev_scheme" ]]; then
    scheme_match=0
  fi
  if [[ "$hash_ok" -eq 1 && "$cache_match" -eq 1 && "$scheme_match" -eq 1 ]]; then
    cur_scheme="$(noctalia msg color-scheme-get 2>/dev/null || true)"
    if [[ "$cur_scheme" != "wallpaper $WALLPAPER_SCHEME" ]]; then
      noctalia msg color-scheme-set wallpaper "$WALLPAPER_SCHEME" >/dev/null 2>&1 || true
      touch "$THEME_MARKER"
    fi
    if command -v waywallen-gtk-qt-palette >/dev/null 2>&1; then
      waywallen-gtk-qt-palette "$CACHE_JPG" >>"$LOG" 2>&1 || log "WARN: waywallen-gtk-qt-palette (unchanged path) failed"
    fi
    log "unchanged $STATE_PAYLOAD item_id=$ITEM_ID source=$SOURCE src=$SRC — exit 0"
    exit 0
  fi
  log "re-apply (src_ok=$hash_ok cache_ok=$cache_match scheme_ok=$scheme_match) for $STATE_KEY"
fi

ext_lower="${SRC##*.}"
ext_lower="${ext_lower,,}"
TMP="$CACHE_JPG.tmp.$$"
MIN_DIM=400
UPSCALE_LONG=1024
# Blue Sky workshop (preview.gif only); optional enrichment from historical wallhaven palette.
BLUE_SKY_ID="2944773634"
WALLHAVEN_ENRICH="${WAYWALLEN_PALETTE_ENRICH:-$HOME/Pictures/wallhaven-1q2zd1.jpg}"
USED_ENRICH=0

cleanup() { rm -f "$TMP" "$CACHE_DIR/waywallen-apply-$$.jpg" "$CACHE_DIR/waywallen-enrich-$$.jpg" 2>/dev/null || true; }
trap cleanup EXIT

_img_wh() {
  local f="$1"
  if command -v magick >/dev/null 2>&1; then
    magick identify -format '%w %h' "${f}[0]" 2>/dev/null || echo '0 0'
  elif command -v identify >/dev/null 2>&1; then
    identify -format '%w %h' "${f}[0]" 2>/dev/null || echo '0 0'
  else
    echo '0 0'
  fi
}

encode_jpeg() {
  local in="$1" frame_gif="$2"
  local w h long_side need_up=0
  read -r w h <<<"$(_img_wh "$in")"
  long_side=$w
  (( h > w )) && long_side=$h
  if [[ "$frame_gif" == 1 ]] || (( w > 0 && w < MIN_DIM )) || (( h > 0 && h < MIN_DIM )); then
    need_up=1
  fi

  local -a resize_args=()
  if [[ "$need_up" == 1 ]]; then
    # At least UPSCALE_LONG on the long side (Lanczos). Only enlarge when smaller.
    if (( long_side > 0 && long_side < UPSCALE_LONG )); then
      if (( w >= h )); then
        resize_args=(-filter Lanczos -resize "${UPSCALE_LONG}x")
      else
        resize_args=(-filter Lanczos -resize "x${UPSCALE_LONG}")
      fi
    fi
  fi

  if command -v magick >/dev/null 2>&1; then
    if [[ "$frame_gif" == 1 ]]; then
      magick "${in}[0]" "${resize_args[@]}" -strip -quality 92 jpeg:"$TMP" || die "magick failed on $in"
    else
      magick "$in" "${resize_args[@]}" -strip -quality 92 jpeg:"$TMP" || die "magick convert failed on $in"
    fi
  elif command -v convert >/dev/null 2>&1; then
    if [[ "$frame_gif" == 1 ]]; then
      convert "${in}[0]" "${resize_args[@]}" -strip -quality 92 jpeg:"$TMP" || die "convert failed on $in"
    else
      convert "$in" "${resize_args[@]}" -strip -quality 92 jpeg:"$TMP" || die "convert failed on $in"
    fi
  elif command -v ffmpeg >/dev/null 2>&1; then
    local vf="scale=iw:ih"
    if [[ "$need_up" == 1 ]] && (( long_side > 0 && long_side < UPSCALE_LONG )); then
      vf="scale='if(gte(iw,ih),${UPSCALE_LONG},-1)':'if(gte(ih,iw),${UPSCALE_LONG},-1)':flags=lanczos"
    fi
    ffmpeg -y -loglevel error -i "$in" -frames:v 1 -q:v 2 -vf "$vf" "$TMP.jpg" \
      || die "ffmpeg failed on $in"
    mv -f "$TMP.jpg" "$TMP"
  else
    die "need magick/convert/ffmpeg to encode JPEG"
  fi
}

case "$ext_lower" in
  gif) encode_jpeg "$SRC" 1 ;;
  webp|png|jpeg|jpg) encode_jpeg "$SRC" 0 ;;
  *) die "unsupported preview type: $ext_lower ($SRC)" ;;
esac

# Optional enrichment for known Blue Sky / gif-only case after upscale.
# Disabled by default: Blue Sky preview.gif already yields faithful sky-blue seeds;
# a boot-race once left a purple Day/Night cache that enrichment could not heal.
# Opt in: WAYWALLEN_PALETTE_ENRICH_ENABLE=1
read -r out_w out_h <<<"$(_img_wh "$TMP")"
if [[ "${WAYWALLEN_PALETTE_ENRICH_ENABLE:-0}" == "1" && "$EXTERNAL_ID" == "$BLUE_SKY_ID" && "$ext_lower" == "gif" && -f "$WALLHAVEN_ENRICH" ]]; then
  ENRICH_TMP="$CACHE_DIR/waywallen-enrich-$$.jpg"
  if command -v magick >/dev/null 2>&1; then
    if magick "$WALLHAVEN_ENRICH" -resize "${UPSCALE_LONG}x${UPSCALE_LONG}^" -gravity center -extent "${UPSCALE_LONG}x${UPSCALE_LONG}" \
         "$TMP" -resize "${UPSCALE_LONG}x${UPSCALE_LONG}^" -gravity center -extent "${UPSCALE_LONG}x${UPSCALE_LONG}" \
         -compose blend -define compose:args=40,60 -composite -strip -quality 92 jpeg:"$ENRICH_TMP" 2>/dev/null; then
      mv -f "$ENRICH_TMP" "$TMP"
      USED_ENRICH=1
      log "enriched Blue Sky gif cache with wallhaven-1q2zd1 (blend; wallpaper id unchanged)"
    else
      rm -f "$ENRICH_TMP"
      log "WARN: wallhaven enrich failed — keeping upscaled gif"
    fi
  elif command -v convert >/dev/null 2>&1; then
    if convert "$WALLHAVEN_ENRICH" -resize "${UPSCALE_LONG}x${UPSCALE_LONG}^" -gravity center -extent "${UPSCALE_LONG}x${UPSCALE_LONG}" \
         "$TMP" -resize "${UPSCALE_LONG}x${UPSCALE_LONG}^" -gravity center -extent "${UPSCALE_LONG}x${UPSCALE_LONG}" \
         -compose blend -define compose:args=40,60 -composite -strip -quality 92 jpeg:"$ENRICH_TMP" 2>/dev/null; then
      mv -f "$ENRICH_TMP" "$TMP"
      USED_ENRICH=1
      log "enriched Blue Sky gif cache with wallhaven-1q2zd1 (blend; wallpaper id unchanged)"
    else
      rm -f "$ENRICH_TMP"
      log "WARN: wallhaven enrich failed — keeping upscaled gif"
    fi
  fi
fi

mv -f "$TMP" "$CACHE_JPG"
trap - EXIT

ensure_theme() {
  local cur
  cur="$(noctalia msg color-scheme-get 2>/dev/null || true)"
  if [[ "$cur" != "wallpaper $WALLPAPER_SCHEME" ]]; then
    noctalia msg color-scheme-set wallpaper "$WALLPAPER_SCHEME" >/dev/null
    log "set color-scheme wallpaper $WALLPAPER_SCHEME (was: $cur)"
  fi
  touch "$THEME_MARKER"
}

ensure_theme

# Bust path-identity caches: set via unique copy first, then stable path
APPLY_TMP="$CACHE_DIR/waywallen-apply-$$.jpg"
cp -f "$CACHE_JPG" "$APPLY_TMP"
noctalia msg wallpaper-set "$APPLY_TMP" >/dev/null 2>&1 || true
noctalia msg wallpaper-set "$CACHE_JPG" >/dev/null
rm -f "$APPLY_TMP"

# Re-assert scheme so palette regenerates from new wallpaper
noctalia msg color-scheme-set wallpaper "$WALLPAPER_SCHEME" >/dev/null

# Extra nudge when content changed (same stable path)
noctalia msg config-reload >/dev/null 2>&1 || true

# Verify wallpaper.enabled stays false (warn only)
en="$(awk '
  BEGIN{inw=0}
  $0=="[wallpaper]"{inw=1;next}
  $0 ~ /^\[/{inw=0}
  inw && $0 ~ /^enabled[[:space:]]*=/{print $3; exit}
' "${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml" 2>/dev/null || true)"
if [[ "$en" == "true" ]]; then
  log "WARN: [wallpaper] enabled became true — leaving as-is (keep false; check manually)"
fi

# Refresh cache fingerprint after encode (source hash alone is not enough).
CACHE_HASH=""
if command -v sha256sum >/dev/null 2>&1; then
  CACHE_HASH="$(sha256sum "$CACHE_JPG" | awk '{print $1}')"
elif command -v sha256 >/dev/null 2>&1; then
  CACHE_HASH="$(sha256 -q "$CACHE_JPG" 2>/dev/null || true)"
fi
STATE_PAYLOAD="$STATE_KEY"
[[ -n "$SRC_HASH" ]] && STATE_PAYLOAD="$STATE_PAYLOAD sha256:$SRC_HASH"
[[ -n "$CACHE_HASH" ]] && STATE_PAYLOAD="$STATE_PAYLOAD cache:$CACHE_HASH"
STATE_PAYLOAD="$STATE_PAYLOAD scheme:$WALLPAPER_SCHEME"

printf '%s\n' "$STATE_PAYLOAD" >"$STATE_FILE"
scheme="$(noctalia msg color-scheme-get 2>/dev/null || echo '?')"
dims="$(_img_wh "$CACHE_JPG")"
log "applied $STATE_PAYLOAD item_id=$ITEM_ID external=$EXTERNAL_ID source=$SOURCE src=$SRC cache=$CACHE_JPG dims=$dims enrich=$USED_ENRICH scheme=[$scheme]"

# Propagate same wallpaper image → GTK3/4 + KDE MaterialYouDark + qt5ct (sibling; no second daemon).
if command -v waywallen-gtk-qt-palette >/dev/null 2>&1; then
  if waywallen-gtk-qt-palette --force "$CACHE_JPG" >>"$LOG" 2>&1; then
    log "gtk-qt-palette applied from $CACHE_JPG"
  else
    log "WARN: waywallen-gtk-qt-palette failed (Noctalia palette still applied)"
  fi
else
  log "WARN: waywallen-gtk-qt-palette not installed — GTK/Qt not updated"
fi
exit 0
