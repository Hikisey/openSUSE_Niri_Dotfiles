    animations {
        // Middle ground: snappy enough for settings, not as harsh as 0.7
        slowdown 0.85

        workspace-switch {
            spring damping-ratio=0.88 stiffness=820 epsilon=0.0001
        }
        window-open {
            duration-ms 200
            curve "ease-out-cubic"
        }
        window-close {
            duration-ms 170
            curve "ease-out-quad"
        }
        horizontal-view-movement {
            spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=0.91 stiffness=820 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=0.93 stiffness=880 epsilon=0.0001
        }
        config-notification-open-close {
            spring damping-ratio=0.8 stiffness=900 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 180
            curve "ease-out-quad"
        }
        overview-open-close {
            spring damping-ratio=0.9 stiffness=820 epsilon=0.0001
        }
    }
