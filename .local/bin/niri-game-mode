#!/usr/bin/env python3
"""Disable niri animations and compositor effects while a window covers an output."""
from __future__ import annotations

import json
import subprocess
import sys
import time
from pathlib import Path

CFG = Path.home() / ".config/niri/cfg/game-mode.kdl"

ON = """\
// auto-generated by niri-game-mode — fullscreen: effects off
animations {
    off
}

window-rule {
    opacity 1.0
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry false
}

window-rule {
    background-effect {
        blur false
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-"
    background-effect {
        blur false
        xray false
    }
}
"""

OFF = """\
// auto-generated by niri-game-mode — inactive
"""

INTERESTING_PREFIXES = ("Window", "Workspace", "Output")


def niri_json(*args):
    raw = subprocess.check_output(["niri", "msg", "--json", *args], stderr=subprocess.DEVNULL)
    return json.loads(raw)


def fullscreen_on_active_output() -> bool:
    try:
        outputs = niri_json("outputs") or {}
        workspaces = niri_json("workspaces") or []
        windows = niri_json("windows") or []
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        return False

    sizes = {}
    for name, o in outputs.items():
        logical = o.get("logical") or {}
        try:
            sizes[name] = (int(logical["width"]), int(logical["height"]))
        except (KeyError, TypeError, ValueError):
            continue

    active = {ws["id"] for ws in workspaces if ws.get("is_active")}
    ws_out = {ws["id"]: ws.get("output") for ws in workspaces}

    for win in windows:
        wid = win.get("workspace_id")
        if wid not in active:
            continue
        layout = win.get("layout") or {}
        size = layout.get("window_size") or [0, 0]
        try:
            ww, hh = int(size[0]), int(size[1])
        except (TypeError, ValueError, IndexError):
            continue
        oname = ws_out.get(wid)
        candidates = [sizes[oname]] if oname in sizes else list(sizes.values())
        for ow, oh in candidates:
            if abs(ww - ow) <= 2 and abs(hh - oh) <= 2:
                return True
    return False


def apply(on: bool) -> None:
    CFG.parent.mkdir(parents=True, exist_ok=True)
    text = ON if on else OFF
    try:
        if CFG.exists() and CFG.read_text() == text:
            return
    except OSError:
        pass
    tmp = CFG.with_name("game-mode.kdl.tmp")
    tmp.write_text(text)
    tmp.replace(CFG)
    subprocess.call(["niri", "msg", "action", "load-config-file"], stderr=subprocess.DEVNULL)


def sync() -> bool:
    on = fullscreen_on_active_output()
    apply(on)
    return on


def watch() -> None:
    apply(False)
    while True:
        try:
            proc = subprocess.Popen(
                ["niri", "msg", "--json", "event-stream"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
            )
            assert proc.stdout is not None
            sync()
            last = time.monotonic()
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    ev = json.loads(line)
                except json.JSONDecodeError:
                    continue
                key = next(iter(ev), "")
                if not any(key.startswith(p) for p in INTERESTING_PREFIXES):
                    continue
                now = time.monotonic()
                if now - last < 0.08:
                    continue
                last = now
                sync()
            proc.wait()
        except Exception:
            pass
        time.sleep(1.5)


def main() -> None:
    if "--watch" in sys.argv:
        watch()
        return
    on = sync()
    print("on" if on else "off")


if __name__ == "__main__":
    main()
